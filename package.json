{
  "name": "counter-widget",
  "version": "0.28.0",
  "description": "ЛАД — Люди. Аналітика. Документи. Облік роботи співробітників, чергувань і завдань",
  "main": "src/main/bootstrap.js",
  "author": "sendmefile77-eng",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ua.local.counterwidget",
    "productName": "ЛАД",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Counter.${ext}"
    },
    "asarUnpack": [
      "src/main/document-worker.js",
      "src/main/document-reader.js",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/rus": "1.0.0",
    "@tesseract.js-data/ukr": "1.0.0",
    "exceljs": "4.4.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0"
  }
}
